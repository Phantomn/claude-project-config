{
  "description": "harness-core — Bash 자동승인/차단 가드(재귀삭제 대상 판정·코드읽기 codegraph 유도) + Read 코드파일 넛지 + codegraph/serena 사용 시 카운터 리셋.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/auto-approve-readonly.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-read-codefile.sh\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__codegraph.*|mcp__serena.*",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/reset-coderead-count.sh\"", "timeout": 10 }
        ]
      }
    ]
  }
}
